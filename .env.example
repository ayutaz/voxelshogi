# Local control-plane credentials. Copy to .env and edit locally; never commit it.
# Do not copy .env or provider API keys onto rented GPU instances.
# The pilot itself does not need these keys and does not load .env.
VAST_API_KEY=
CLOUDRIFT_API_KEY=

# Optional dedicated HF write token for voxelshogi publication.
# Pass only to the publishing process in memory; do not copy .env to a GPU host.
HF_TOKEN=
