{
  "name": "@voxelshogi/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "wasm": "bash ../../scripts/build-wasm.sh",
    "dev": "vite",
    "build": "tsc -b && vite build && node ../../scripts/ci/deployment.mjs stamp dist && node ../../scripts/inference-build.mjs dist",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "deploy": "../../scripts/cf.sh deploy"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "onnxruntime-web": "1.31.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "@webgpu/types": "0.1.74",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "miniflare>undici": "7.30.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
